# Copy to `.env.qa` for local / CI QA runs.
# Never point destructive tests at production.

# --- App URLs (optional overrides) ---
QA_WEB_URL=http://127.0.0.1:3000
QA_CMS_URL=http://127.0.0.1:3001
QA_WEB_PORT=3000
QA_CMS_PORT=3001
# QA_REUSE_SERVERS=1

# --- Supabase (shared by web + CMS; prefer a dedicated test project) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Mapbox (required for vineyard map E2E) ---
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- CMS admin session secret (same as CMS ADMIN_SESSION_SECRET / service role fallback) ---
ADMIN_SESSION_SECRET=

# --- Optional seeded auth accounts (public app) ---
QA_FREE_EMAIL=
QA_FREE_PASSWORD=
QA_PREMIUM_EMAIL=
QA_PREMIUM_PASSWORD=

# --- Optional fixture overrides (otherwise discovered from published content) ---
# QA_FIXTURE_REGION_SLUG=bordeaux
# QA_FIXTURE_SUBREGION_SLUG=
# QA_FIXTURE_AOP_SLUG=
# QA_FIXTURE_GRAPE_SLUG=
# QA_FIXTURE_SOIL_SLUG=
# QA_FIXTURE_VINIFICATION_SLUG=

# Safety: set to 1 only for a disposable remote test project (never production)
# QA_ALLOW_REMOTE_DB=1

# Optional issue metadata for QA_REPORT.md
# QA_ISSUE=#23 — DGC Parent / Child
# QA_REPAIR_CYCLES=0
