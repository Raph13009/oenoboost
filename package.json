{
  "name": "oenoboost",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev:web": "pnpm --filter oenoboost-app exec next dev -p 3000",
    "dev:cms": "pnpm --filter oenoboost-1 exec next dev -p 3001",
    "build:web": "NODE_OPTIONS='--max-old-space-size=8192' pnpm --filter oenoboost-app build",
    "build:cms": "NODE_OPTIONS='--max-old-space-size=8192' pnpm --filter oenoboost-1 build",
    "build": "pnpm run build:web && pnpm run build:cms",
    "lint:web": "pnpm --filter oenoboost-app lint",
    "lint:cms": "pnpm --filter oenoboost-1 lint",
    "lint": "pnpm run lint:web && pnpm run lint:cms",
    "typecheck:web": "pnpm --filter oenoboost-app exec tsc --noEmit",
    "typecheck:cms": "pnpm --filter oenoboost-1 exec tsc --noEmit",
    "typecheck": "pnpm run typecheck:web && pnpm run typecheck:cms",
    "test:unit:web": "pnpm --filter oenoboost-app test",
    "test:unit:cms": "pnpm --filter oenoboost-1 test",
    "test:unit": "pnpm run test:unit:web && pnpm run test:unit:cms",
    "qa:db": "node qa/db-check.mjs",
    "qa:smoke": "playwright test --grep @smoke",
    "qa:app": "playwright test tests/e2e/app tests/regression/app",
    "qa:cms": "playwright test tests/e2e/cms tests/regression/cms",
    "qa:regression": "playwright test tests/regression",
    "qa:health": "playwright test tests/e2e/app/content-health.spec.ts",
    "qa:e2e": "playwright test",
    "qa:report": "node qa/report.mjs",
    "qa:full": "node qa/run-full.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@supabase/supabase-js": "^2.100.0",
    "dotenv": "^17.3.1"
  }
}
